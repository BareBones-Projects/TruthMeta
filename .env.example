# TruthMeta local-only alpha. Copy into a private .env file and never commit it.
PORT=8787
BIND=127.0.0.1
METATRUTH_ADMIN_EMAIL=admin@metatruth.local
# REQUIRED on first run: set a unique random password of at least 16 characters.
METATRUTH_ADMIN_PASSWORD=
# Optional: comma-separated exact extension origins, e.g. chrome-extension://<installed-extension-id>
METATRUTH_ALLOWED_ORIGINS=
# Optional for tests or isolated local data directory:
# METATRUTH_DB_PATH=
